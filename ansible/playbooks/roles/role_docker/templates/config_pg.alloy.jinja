// =============================
// mimir
// =============================
discovery.relabel "postgres_exporter" {
  targets = [
    {
      __address__ = "localhost:9187",
      job         = "postgres_exporter",
      cluster     = "postgres-cluster",
      environment = "production",
      instance    = "{{ ansible_facts['hostname'] }}",
      ip_address  = "{{ ansible_facts['default_ipv4']['address'] }}",
    },
  ]
}

prometheus.scrape "postgres_exporter" {
  targets = discovery.relabel.postgres_exporter.output
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "{{ obs_server_proto }}://{{ obs_server_fqdn }}:{{ obs_server_port }}/api/v1/push"

    headers = {
      "X-Scope-OrgID" = "fake",
    }

    queue_config {
      capacity             = 10000
      max_samples_per_send = 1000
      batch_send_deadline  = "10s"
    }
  }
}

prometheus.exporter.unix "system" {}

prometheus.scrape "system" {
  targets = prometheus.exporter.unix.system.targets

  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]
}

prometheus.exporter.cadvisor "docker" {}

prometheus.scrape "docker" {
  targets = prometheus.exporter.cadvisor.docker.targets

  forward_to = [
    prometheus.remote_write.mimir.receiver,
  ]
}

// =============================
// loki
// =============================
// 1. Обнаружение контейнеров Docker
discovery.docker "flog_scrape" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

// 2. Релейблинг и добавление меток
discovery.relabel "flog_scrape" {
  targets = discovery.docker.flog_scrape.targets

  // Добавляем имя хоста как метку
  rule {
    target_label = "instance"
    replacement  = constants.hostname
  }

  // Извлекаем имя контейнера из метаданных Docker
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  // Добавляем поток логов (stdout/stderr)
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "logstream"
  }

  // Используем метку из Docker-контейнера как job name, или значение по умолчанию
  rule {
    source_labels = ["__meta_docker_container_label_logging_jobname"]
    target_label  = "job"
    replacement   = "docker-logs"  // Значение по умолчанию
  }

  // Добавляем образ контейнера как метку
  rule {
    source_labels = ["__meta_docker_container_image"]
    target_label  = "image"
    replacement   = "$1"
  }
}

// 3. Сбор логов из Docker-контейнеров
loki.source.docker "flog_scrape" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.flog_scrape.output
  refresh_interval = "5s"
  forward_to       = [loki.process.add_metadata.receiver]
}

// 4. Обработка логов: добавление дополнительных меток
loki.process "add_metadata" {
  // Добавляем статические метки для идентификации
  stage.static_labels {
    values = {
      env      = "production",  // Измените под ваше окружение
      datacenter = "local",
      collector = "alloy",
    }
  }

  // Опционально: фильтрация логов
  stage.match {
    selector = `{container="test-logger"} |= "healthcheck"`
    action   = "drop"
  }

  // Опционально: извлечение уровня логирования
  stage.regex {
    expression = `^(?P<level>INFO|WARN|ERROR|DEBUG|FATAL)`
  }

  forward_to = [loki.write.default.receiver]
}

// 5. Отправка логов в Loki
loki.write "default" {
  endpoint {
    url = "{{ obs_server_proto }}://{{ obs_server_fqdn }}:{{ obs_server_loki_port }}/loki/api/v1/push"
    
    // Базовая аутентификация (если нужна)
    // basic_auth {
    //   username = "user"
    //   password = "pass"
    // }
  }
  
  // Внешние метки для всех логов
  external_labels = {
    source = "docker",
    datacenter = "local",
  }
}

// 6. Включение отладки
livedebugging {
  enabled = true
}