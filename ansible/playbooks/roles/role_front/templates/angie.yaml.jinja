services:
  angie:
    image: docker.angie.software/angie:latest
    container_name: "angie"
    restart: always
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "${HTTP_PORT:-80}:80"
      - "${HTTPS_PORT:-443}:443/tcp"
      - "${HTTPS_PORT:-443}:443/udp"  # HTTP/3 (QUIC)
    environment:
      TZ: "${TZ:-UTC}"
      AUTO_UPDATE_GEOIP: "${AUTO_UPDATE_GEOIP:-false}"
      GEOIP_MAX_AGE_DAYS: "${GEOIP_MAX_AGE_DAYS:-30}"
    volumes:
      - ./angie.conf:/etc/angie/angie.conf
      - angie_data:/var/www
      - angie_logs:/var/log/angie
      - angie_configs:/etc/angie/http.d
      - angie_streams:/etc/angie/stream.d
      - angie_certs:/var/lib/angie/acme
      - geoip:/usr/share/geoip
    networks:
      frontend:
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.5'
          memory: 256M

networks:

  frontend:
    external: true

volumes:

  # for GeoIP module
  geoip:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ angie_path }}/data/geoip"

  # angie volumes

  angie_data:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ angie_path }}/data/data"

  angie_logs:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ angie_path }}/data/logs"
  angie_configs:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ angie_path }}/data/http.d"

  angie_streams:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ angie_path }}/data/stream.d"

  # shared certs
  angie_certs:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ angie_certs_folder }}"