services:

  drupal:
    image: "{{ img_drupal }}"
    container_name: "${DRUPAL_SITE_NAME}"
    restart: unless-stopped
    expose:
      - "80"
    environment:
      # Postgres creds
      POSTGRES_DB: "${POSTGRES_DB}"
      POSTGRES_USER: "${POSTGRES_USER}"
      POSTGRES_PASSWORD: "${POSTGRES_PASSWORD}"
      POSTGRES_DB_PORT: "${POSTGRES_DB_PORT}"
      PG_HOST: "${PG_HOST}"
      # Site
      DRUPAL_ADMIN_USER: "${DRUPAL_ADMIN_USER}"
      DRUPAL_ADMIN_PASSWORD: "${DRUPAL_ADMIN_PASSWORD}"
      DRUPAL_ADMIN_EMAIL: "${DRUPAL_ADMIN_EMAIL}"
      DRUPAL_SITE_NAME: "${DRUPAL_SITE_NAME}"
    entrypoint: ["/usr/local/bin/entrypoint.sh"]
    volumes:
      - './entrypoint.sh:/usr/local/bin/entrypoint.sh'
      # /var/www/html -> /opt/drupal/web
      - "cms_web:/var/www/html"
      - "cms_data:/opt/drupal"
      - "cms_backup:{{ drupal_container_backup_folder }}"
    networks:
      {{ docker.networks.net01 }}:

networks:
  {{ docker.networks.net01 }}:
    external: true

volumes:

  cms_data:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ drupal_data_data_path }}"

  cms_web:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ drupal_data_web_path }}"

  cms_backup:
    driver: local
    driver_opts:
      type: "none"
      o: "bind"
      device: "{{ drupal_data_backup_path }}"
