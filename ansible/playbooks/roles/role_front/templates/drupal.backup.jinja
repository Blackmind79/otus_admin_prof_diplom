#!/usr/bin/env bash

set -euo pipefail

echo "Start backup drupal site [{{ drupal_site_name }}]..."
BACKUP_DIR="{{ drupal_container_backup_folder }}"
SITE_DIR="/opt/drupal"
BACKUP_ARCH_NAME="${BACKUP_DIR}/drupal-site-$(date +%F-%H%M).tar.gz"

## To avoid message 'tar: Removing leading '/' from member names' change dir
cd "${SITE_DIR}"
docker exec -t {{ drupal_site_name }} tar -czf "${BACKUP_ARCH_NAME}" .

## if backup folder is not mounted to NAS, use rsync:
# rsync -avz "${BACKUP_DIR}/" "path_to_external_backup_destination"
rsync -avz "${BACKUP_DIR}/" "{{ nfs_client_mount_point }}"

## Copy to S3
# rclone copy /путь/к/файлу.txt имя-хранилияща-в-конфиге-rclone:имя-вашего-бакета/
rclone copy "${BACKUP_ARCH_NAME}" "{{ s3_rclone_config_name }}:{{ s3_bucket_name }}/"

